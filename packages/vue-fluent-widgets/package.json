{
  "packageManager": "bun@1.3.14",
  
  "name": "vue-fluent-widgets",
  "version": "1.0.2",
  "description": "A collection of Fluent Design System (WinUI3) components for Vue",
  "author": "Cyrene2008 <https://github.com/Cyrene2008>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyrene2008/VueFluentWidgets.git"
  },
  "type": "module",
  "main": "./dist/vue-fluent-widgets.umd.cjs",
  "module": "./dist/vue-fluent-widgets.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-fluent-widgets.js",
      "require": "./dist/vue-fluent-widgets.umd.cjs"
    },
    "./style.css": "./dist/vue-fluent-widgets.css",
    "./package.json": "./package.json"
  },
  "sideEffects": ["./dist/vue-fluent-widgets.css"],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@iconify-json/fluent": "^1.2.10",
    "vue-router": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@iconify-json/fluent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.3.5",
    "vue": "^3.5.17"
  },
  "keywords": ["vue", "fluent", "design-system", "winui3", "components"],
  "license": "MIT"
}

