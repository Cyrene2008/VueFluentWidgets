{
  "name": "vue-fluent-widgets",
  "version": "0.1.0",
  "description": "A collection of Fluent Design System (WinUI3) components for Vue",
  "author": "Cyrene2008 <https://github.com/Cyrene2008>",
  "type": "module",
  "main": "./dist/vue-fluent-widgets.umd.cjs",
  "module": "./dist/vue-fluent-widgets.js",
  "exports": {
    ".": {
      "import": "./dist/vue-fluent-widgets.js",
      "require": "./dist/vue-fluent-widgets.umd.cjs"
    },
    "./style.css": "./dist/vue-fluent-widgets.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "@iconify-json/fluent": "^1.2.10",
    "vue-router": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@iconify-json/fluent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.3.5",
    "vue": "^3.5.17"
  },
  "keywords": ["vue", "fluent", "design-system", "winui3", "components"],
  "license": "MIT"
